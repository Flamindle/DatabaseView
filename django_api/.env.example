# Django 环境配置示例
# 复制此文件为 .env 并填入实际值

# Django 安全密钥（生产环境必须修改）
SECRET_KEY=your-secret-key-here

# 调试模式
DEBUG=True

# 允许的域名（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 数据库配置
# 注意：这里的配置需要与 Node.js 项目的数据库配置一致
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=your_database_name_here
